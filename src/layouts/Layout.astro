---

import "../styles/global.css";
import { profile } from "../data/profile";

interface Props {
  title?: string;
  description?: string;
}

const {
  title = `${profile.name} | ${profile.role}`,
  description = profile.intro,
} = Astro.props;

const canonical = new URL(Astro.url.pathname, Astro.site).href;
const image = new URL(profile.profileImage, Astro.site);

const personSchema = {
  "@context": "https://schema.org",
  "@type": "Person",
  name: profile.name,
  jobTitle: profile.role,
  description: profile.intro,
  email: `mailto:${profile.email}`,
  url: canonical,
  image: image.href,
  sameAs: profile.socials.map((social) => social.href),
};
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="author" content={profile.name} />
    <meta name="theme-color" content="#ffffff" />
    <link rel="canonical" href={canonical} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="preload" href={profile.profileImage} as="image" fetchpriority="high" />

    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:site_name" content={profile.name} />
    <meta property="og:image" content={image.href} />
    <meta property="og:image:alt" content={profile.profileImageAlt} />

    <script is:inline>
      document.documentElement.classList.add("js");
    </script>
    <script type="application/ld+json" set:html={JSON.stringify(personSchema)} />
    {import.meta.env.PROD && (
      <script
        is:inline
        type="module"
        src="https://static.cloudflareinsights.com/beacon.min.js"
        data-cf-beacon='{"token": "f9058ef0e61c4768b655ff640993b124"}'
      ></script>
    )}
  </head>
  <body>
    <a href="#main" class="skip-link">Skip to content</a>
    <slot />
    <script>
      import "../scripts/main";
    </script>
  </body>
</html>
