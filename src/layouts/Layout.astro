---

import "../styles/global.css";
import { profile } from "../data/profile";

interface Props {
  title?: string;
  description?: string;
}

const {
  title = `${profile.name} — ${profile.role}`,
  description = profile.intro,
} = Astro.props;

const canonical = new URL(Astro.url.pathname, Astro.site).href;
const image = new URL(profile.profileImage, Astro.site);

const personSchema = {
  "@context": "https://schema.org",
  "@type": "Person",
  name: profile.name,
  jobTitle: profile.role,
  description: profile.intro,
  email: `mailto:${profile.email}`,
  url: canonical,
  image: image.href,
  sameAs: profile.socials.map((social) => social.href),
};
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="author" content={profile.name} />
    <meta name="theme-color" content="#f3efe4" />
    <link rel="canonical" href={canonical} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="preload" href={profile.profileImage} as="image" fetchpriority="high" />

    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:site_name" content={profile.name} />
    <meta property="og:image" content={image.href} />
    <meta property="og:image:alt" content={profile.profileImageAlt} />
    <meta name="twitter:card" content="summary" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={image.href} />
    <meta name="twitter:image:alt" content={profile.profileImageAlt} />

    <script is:inline>
      document.documentElement.classList.add("js");
    </script>
    <script is:inline>
      (() => {
        const saved = localStorage.getItem("theme");
        const valid = saved === "dark" || saved === "light";
        const theme = valid
          ? saved
          : window.matchMedia("(prefers-color-scheme: dark)").matches
            ? "dark"
            : "light";
        document.documentElement.setAttribute("data-theme", theme);
      })();
    </script>
    <script type="application/ld+json" set:html={JSON.stringify(personSchema)} />
  </head>
  <body>
    <a
      href="#main"
      class="sr-only focus:not-sr-only focus:fixed focus:left-4 focus:top-4 focus:z-[120] focus:border focus:border-ink focus:bg-paper-2 focus:px-4 focus:py-2 focus:font-mono focus:text-xs focus:uppercase focus:tracking-widest"
    >
      Skip to content
    </a>
    <slot />
    <script>
      import "../scripts/main";
    </script>
  </body>
</html>
