---
import Layout from "../layouts/Layout.astro";
---

<Layout
  title="404 | Page not found"
  description="This page does not exist. Head back to the portfolio."
  noindex={true}
>
  <div class="page-shell">
    <main id="main" class="not-found">
      <div class="not-found__box">
        <p class="label">Error / 404</p>
        <p class="not-found__code" aria-hidden="true">404</p>
        <h1 class="not-found__title">This page does not exist.</h1>
        <p class="not-found__text">
          The page you are looking for moved or was never here. Head back to the
          portfolio and pick up where you left off.
        </p>
        <div class="not-found__actions">
          <a class="btn btn--lime" href="/">Back home <span aria-hidden="true">←</span></a>
          <a class="btn" href="/#projects">See projects <span aria-hidden="true">→</span></a>
        </div>
      </div>
    </main>
  </div>
</Layout>