---
import Layout from "../layouts/Layout.astro";
import Nav from "../components/Nav.astro";
import Hero from "../components/Hero.astro";
import SkillsStrip from "../components/SkillsStrip.astro";
import FeaturedProjects from "../components/FeaturedProjects.astro";
import Certifications from "../components/Certifications.astro";
import ExperienceBento from "../components/ExperienceBento.astro";
import Footer from "../components/Footer.astro";
---

<Layout preloadImage={true} includePerson={true}>
  <div class="page-shell">
    <Nav />
    <main id="main">
      <Hero />
      <SkillsStrip />
      <div class="row-two">
        <FeaturedProjects />
        <Certifications />
      </div>
      <ExperienceBento />
    </main>
    <Footer />
  </div>
</Layout>