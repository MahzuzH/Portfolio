---
import { profile } from "../data/profile";

const films = profile.topFilms;
const letterboxdUrl = profile.letterboxdUsername
  ? `https://letterboxd.com/${profile.letterboxdUsername}/`
  : "https://letterboxd.com/";
---

<div class="media-panel__inner letterboxd-section">
  {films.length > 0 ? (
    <div class="letterboxd-grid">
      {films.map((film, index) => (
        <article class="letterboxd-card">
          <a
            href={film.link}
            target="_blank"
            rel="noopener noreferrer"
            class="letterboxd-card__link"
          >
            <div class="letterboxd-card__poster-wrap">
              {film.poster ? (
                <img
                  src={film.poster}
                  alt={`Poster ${film.title}`}
                  class="letterboxd-card__poster"
                  width="600"
                  height="900"
                  loading="lazy"
                  decoding="async"
                />
              ) : (
                <div class="letterboxd-card__poster--empty"></div>
              )}
              <span class="letterboxd-card__rank" aria-hidden="true">
                {String(index + 1).padStart(2, "0")}
              </span>
            </div>
            <div class="letterboxd-card__body">
              <h3 class="letterboxd-card__title">{film.title}</h3>
              <div class="letterboxd-card__meta">
                {film.year && <span class="letterboxd-card__year">{film.year}</span>}
                {film.rating && <span class="letterboxd-card__rating">{film.rating}</span>}
              </div>
            </div>
          </a>
        </article>
      ))}
    </div>
  ) : (
    <div class="letterboxd-placeholder">
      <p class="letterboxd-placeholder__text">
        Belum ada film favorit yang diatur. Tambahkan <code>topFilms</code> di
        <code>src/data/profile.ts</code> untuk menampilkan empat film pilihanmu.
      </p>
    </div>
  )}

  <p class="media-panel__note">
    Four favourites, in no particular order.
  </p>

  <div class="letterboxd-actions">
    <a
      href={letterboxdUrl}
      target="_blank"
      rel="noopener noreferrer"
      class="btn"
    >
      Buka Letterboxd <span aria-hidden="true">↗</span>
    </a>
  </div>
</div>
