---
import { profile } from "../data/profile";

const lines = [
  `<span class="code-kw">const</span> me = <span class="code-punct">&#123;</span>`,
  `  name: <span class="code-str">"${profile.name}"</span>,`,
  `  role: <span class="code-str">"software engineer"</span>,`,
  `  base: <span class="code-str">"Jakarta, ID"</span>,`,
  `  focus: <span class="code-str">"design systems + a11y"</span>,`,
  `  stack: [<span class="code-str">"ts"</span>, <span class="code-str">"astro"</span>, <span class="code-str">"react"</span>],`,
  `  available: <span class="code-bool">true</span>,`,
  `<span class="code-punct">&#125;</span>;`,
  ``,
  `<span class="code-comment">// currently: making the web</span>`,
  `<span class="code-comment">// a little less boring</span><span class="code-cursor"></span>`,
];
---

<div class="code-window" aria-hidden="true">
  <div class="code-window__bar">
    <span class="window-dots"><i></i><i></i><i></i></span>
    <span>~/profile.ts</span>
    <span>TS</span>
  </div>

  <div class="code-window__body">
    {lines.map((line, index) => (
      <div class="code-line">
        <span class="code-line__num">{String(index + 1).padStart(2, "0")}</span>
        <span set:html={line}></span>
      </div>
    ))}
  </div>

  <div class="code-window__status">
    <span>UTF-8 · TypeScript</span>
    <span><i></i> ready</span>
  </div>
</div>
