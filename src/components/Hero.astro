---
import { profile } from "../data/profile";
import SocialIcon from "./SocialIcon.astro";

const github = profile.socials.find((social) => social.label === "GitHub")?.href ?? "#";
const linkedin = profile.socials.find((social) => social.label === "LinkedIn")?.href ?? "#";
const letterboxd = `https://letterboxd.com/${profile.letterboxdUsername}/`;
const roleLines = profile.role.split(" ");

const socials = [
  { label: "GitHub", href: github, icon: "github" as const },
  { label: "LinkedIn", href: linkedin, icon: "linkedin" as const },
  { label: "Letterboxd", href: letterboxd, icon: "letterboxd" as const },
  { label: "Email", href: `mailto:${profile.email}`, icon: "mail" as const },
];
---

<section id="top" class="hero">
  <div class="hero__left">
    <div class="hero__grid" aria-hidden="true"></div>

    <div class="hero__content">
      <p class="hero__tag" data-reveal>Hey, I'm Mahzuz <span aria-hidden="true">👋</span></p>

      <h1 class="hero__title" data-reveal style="--reveal-delay: 60ms">
        {roleLines[0]}<br />{roleLines.slice(1).join(" ")}
      </h1>

      <p class="hero__intro" data-reveal style="--reveal-delay: 120ms">
        {profile.intro}
      </p>

      <div class="hero__actions" data-reveal style="--reveal-delay: 180ms">
        <a href="#projects" class="btn btn--lime">
          See my projects <span aria-hidden="true">↗</span>
        </a>
        <a href={profile.resumeUrl} class="btn" download>
          Download resume <span aria-hidden="true">↓</span>
        </a>
      </div>

      <div class="hero__socials" data-reveal style="--reveal-delay: 240ms">
        <p class="label">Connect with me</p>
        <div class="hero__socials-row">
          {socials.map((social) => (
            <SocialIcon label={social.label} href={social.href} icon={social.icon} />
          ))}
        </div>
      </div>
    </div>
  </div>

  <div class="hero__right">
    <div class="hero__portrait-wrap" data-reveal style="--reveal-delay: 140ms">
      <span class="hero__portrait-offset" aria-hidden="true"></span>
      <div class="hero__portrait-frame">
        <img
          class="hero__portrait"
          src={profile.profileImage}
          alt={profile.profileImageAlt}
          width="899"
          height="899"
          fetchpriority="high"
          decoding="async"
          loading="eager"
        />
      </div>
    </div>
  </div>
</section>