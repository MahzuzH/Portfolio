---
import { sections } from "../data/profile";
import SectionHeader from "./SectionHeader.astro";
import SpotifyPlayer from "./SpotifyPlayer.astro";
import Letterboxd from "./Letterboxd.astro";

const tabs = [
  { id: "spotify", index: "01", label: "Spotify" },
  { id: "letterboxd", index: "02", label: "Letterboxd" },
];
---

<section id="media" class="section">
  <div class="container-px">
    <SectionHeader {...sections.media} />

    <div class="media-tabs" role="tablist" aria-label="Media" data-reveal>
      {tabs.map((tab) => (
        <button
          class="media-tab"
          id={`media-tab-${tab.id}`}
          type="button"
          role="tab"
          aria-selected={tab.id === "spotify" ? "true" : "false"}
          aria-controls={`media-panel-${tab.id}`}
          tabindex={tab.id === "spotify" ? 0 : -1}
          data-media-tab={tab.id}
        >
          <span class="media-tab__index" aria-hidden="true">{tab.index}</span>
          {tab.label}
        </button>
      ))}
    </div>

    <div class="media-panels">
      <div
        class="media-panel"
        id="media-panel-spotify"
        role="tabpanel"
        aria-labelledby="media-tab-spotify"
        data-media-panel="spotify"
      >
        <SpotifyPlayer />
      </div>
      <div
        class="media-panel"
        id="media-panel-letterboxd"
        role="tabpanel"
        aria-labelledby="media-tab-letterboxd"
        data-media-panel="letterboxd"
        hidden
      >
        <Letterboxd />
      </div>
    </div>
  </div>
</section>