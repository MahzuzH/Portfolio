---
import { profile } from "../data/profile";

const links = [
  { label: "Skills", href: "#skills" },
  { label: "Projects", href: "#projects" },
  { label: "Experience", href: "#experience" },
  { label: "Certifications", href: "#certifications" },
];
---

<header class="site-nav">
  <div class="nav-inner">
    <a href="#top" class="nav-brand" aria-label={`${profile.name}, back to top`}>
      &lt;/&gt; Mahzuz Dev
    </a>

    <nav class="nav-links" aria-label="Primary">
      {links.map((link) => (
        <a class="nav-link" href={link.href}>{link.label}</a>
      ))}
    </nav>

    <div class="nav-menu-cell">
      <button
        class="nav-toggle"
        type="button"
        aria-expanded="false"
        aria-controls="mobile-menu"
        data-menu-toggle
      >
        <span class="sr-only">Open menu</span>
        <span class="nav-toggle__bars" aria-hidden="true">
          <span></span>
          <span></span>
          <span></span>
        </span>
      </button>
    </div>

    <a href={`mailto:${profile.email}`} class="nav-contact">
      Contact me <span aria-hidden="true">→</span>
    </a>
  </div>

  <div class="nav-dropdown" id="mobile-menu" data-mobile-menu hidden>
    <nav aria-label="Mobile">
      {links.map((link) => (
        <a class="nav-dropdown__link" href={link.href}>{link.label}</a>
      ))}
    </nav>
  </div>
</header>