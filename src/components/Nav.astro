---
import { profile, sections } from "../data/profile";
import LogoMark from "./LogoMark.astro";

const links = Object.entries(sections).map(([id, section]) => ({
  href: `#${id}`,
  label: section.label,
  index: section.index,
}));

const totalLinks = String(links.length).padStart(2, "0");
---

<div class="scroll-progress" aria-hidden="true">
  <div class="scroll-progress__bar" data-progress></div>
</div>

<header class="site-header">
  <div class="container-px nav-inner">
    <a href="#top" class="brand" aria-label={`${profile.name} — back to top`}>
      <span class="brand__mark">
        <LogoMark />
      </span>
    </a>

    <nav class="nav-links" aria-label="Primary">
      {links.map((link) => (
        <a class="nav-link" href={link.href} data-nav-link={link.href.slice(1)}>
          {link.label}
        </a>
      ))}
    </nav>

    <a href="#contact" class="btn nav-cta">
      Let's talk <span aria-hidden="true">↗</span>
    </a>

    <button
      class="theme-toggle"
      type="button"
      aria-label="Toggle dark mode"
      data-theme-toggle
      aria-pressed="false"
    >
      <span class="sr-only">Toggle dark mode</span>
      <svg
        class="theme-toggle__icon theme-toggle__icon--sun"
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="2"
        stroke-linecap="round"
        stroke-linejoin="round"
        aria-hidden="true"
      >
        <circle cx="12" cy="12" r="5" />
        <line x1="12" y1="1" x2="12" y2="3" />
        <line x1="12" y1="21" x2="12" y2="23" />
        <line x1="4.22" y1="4.22" x2="5.64" y2="5.64" />
        <line x1="18.36" y1="18.36" x2="19.78" y2="19.78" />
        <line x1="1" y1="12" x2="3" y2="12" />
        <line x1="21" y1="12" x2="23" y2="12" />
        <line x1="4.22" y1="19.78" x2="5.64" y2="18.36" />
        <line x1="18.36" y1="5.64" x2="19.78" y2="4.22" />
      </svg>
      <svg
        class="theme-toggle__icon theme-toggle__icon--moon"
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="2"
        stroke-linecap="round"
        stroke-linejoin="round"
        aria-hidden="true"
      >
        <path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79" />
      </svg>
    </button>

    <button
      class="nav-toggle"
      type="button"
      aria-expanded="false"
      aria-controls="mobile-menu"
      data-menu-toggle
    >
      <span class="sr-only">Open menu</span>
      <span class="nav-toggle__bars" aria-hidden="true">
        <span></span>
        <span></span>
        <span></span>
      </span>
    </button>
  </div>

  <div class="mobile-menu" id="mobile-menu" data-mobile-menu hidden>
    <nav aria-label="Mobile">
      {links.map((link) => (
        <a class="mobile-menu__link" href={link.href}>
          {link.label}
          <span>{link.index} / {totalLinks}</span>
        </a>
      ))}
    </nav>
    <a href="#contact" class="btn btn--accent mobile-menu__cta">
      Start a conversation <span aria-hidden="true">↗</span>
    </a>
  </div>
</header>
