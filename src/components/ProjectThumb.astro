---
import type { Project } from "../data/profile";

interface Props {
  project: Project;
}

const { project } = Astro.props;
const screenshot = project.shots?.[0];
---

{screenshot ? (
  <div class="thumb thumb--shot">
    <img
      class="thumb__shot"
      src={screenshot}
      alt={project.shotsAlt ?? project.title}
      width="1440"
      height="690"
      loading="lazy"
      decoding="async"
    />
    <span class="thumb__badge">{project.badge}</span>
  </div>
) : (
  <div
    class:list={["thumb", "thumb--poster", `thumb--${project.cover}`]}
    style={`--poster-bg: ${project.coverBg}; --poster-ink: ${project.coverInk};`}
    aria-hidden="true"
  >
    <div class="thumb__poster-meta">
      <span>{project.year}</span>
      <span>{project.label}</span>
    </div>

    <p class="thumb__poster-title">
      <span>{project.thumbLines[0]}</span>
      <span>{project.thumbLines[1]}</span>
    </p>

    <div class="thumb__poster-footer">
      <span class="thumb__poster-mark">{project.mark}</span>
      <span class="thumb__poster-badge">{project.badge}</span>
    </div>
  </div>
)}
