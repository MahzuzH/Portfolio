---
import { profile } from "../data/profile";
import SocialIcon from "./SocialIcon.astro";

const year = new Date().getFullYear();
const firstName = profile.name.split(" ")[0];
const github = profile.socials.find((social) => social.label === "GitHub")?.href ?? "#";
const linkedin = profile.socials.find((social) => social.label === "LinkedIn")?.href ?? "#";

const socials = [
  { label: "GitHub", href: github, icon: "github" as const },
  { label: "LinkedIn", href: linkedin, icon: "linkedin" as const },
  { label: "Email", href: `mailto:${profile.email}`, icon: "mail" as const },
];
---

<footer class="site-footer">
  <a
    href="#top"
    class="nav-brand footer-brand"
    aria-label={`${profile.name}, back to top`}
  >
    &lt;/&gt; Mahzuz Dev
  </a>

  <p class="footer-copy">© {year} {firstName}. All rights reserved.</p>

  <div class="footer-socials">
    {socials.map((social) => (
      <SocialIcon label={social.label} href={social.href} icon={social.icon} />
    ))}
  </div>
</footer>