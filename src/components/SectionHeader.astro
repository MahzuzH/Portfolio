---
interface Props {
  index: string;
  label: string;
  title: string;
  lede?: string;
}

const { index, label, title, lede } = Astro.props;
---

<header class="section-head" data-reveal>
  <p class="eyebrow">{index} / {label}</p>
  <h2 class="section-title">{title}</h2>
  {lede && <p class="section-lede">{lede}</p>}
</header>
