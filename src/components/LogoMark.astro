---
// 8×7 pixel monogram "MH"
const rows = [
  "10011001",
  "10011001",
  "11011111",
  "10111001",
  "10111001",
  "10011001",
  "10011001",
];

const cells = rows.flatMap((row, y) =>
  row.split("").map((cell, x) => ({ x, y, on: cell === "1" })),
);
---

<svg
  width="16"
  height="14"
  viewBox="0 0 8 7"
  fill="currentColor"
  shape-rendering="crispEdges"
  aria-hidden="true"
  focusable="false"
>
  {cells.filter((cell) => cell.on).map((cell) => (
    <rect x={cell.x} y={cell.y} width="1" height="1" />
  ))}
</svg>
