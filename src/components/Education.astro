---
import { certifications, education } from "../data/profile";
import SectionHeader from "./SectionHeader.astro";
---

<section id="education" class="section">
  <div class="container-px">
    <SectionHeader
      index="03"
      label="Education"
      title="Always still learning."
      lede="A formal foundation in computer science, plus a design education I keep adding to — one course and side quest at a time."
    />

    <div class="edu-grid">
      {education.map((item, index) => (
        <article class="edu-card" data-reveal style={`--reveal-delay: ${index * 70}ms`}>
          <div class="edu-card__top">
            <span>EDU.0{index + 1}</span>
            <span>{item.period}</span>
          </div>
          <h3>{item.degree}</h3>
          <p class="edu-card__school">{item.school}</p>
          <p class="edu-card__note">{item.note}</p>
          <p class="edu-card__detail">{item.detail}</p>
          <div class="edu-card__tags">
            {item.tags.map((tag) => (
              <span>{tag}</span>
            ))}
          </div>
        </article>
      ))}
    </div>

    <div class="cert-strip" data-reveal>
      <p class="toolbox__label">Certifications &amp; continuing education</p>
      <div class="cert-list">
        {certifications.map((cert) => (
          <div class="cert-item">
            <span class="cert-item__year">{cert.year}</span>
            <span class="cert-item__name">{cert.name}</span>
            <span class="cert-item__issuer">{cert.issuer}</span>
          </div>
        ))}
      </div>
    </div>
  </div>
</section>
